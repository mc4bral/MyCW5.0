		<None Remove="Views\PublicInfo.cshtml" />
		<None Remove="Views\AuditLog.cshtml" />
		<None Remove="Views\SsoAccounts.cshtml" />
		<None Remove="Views\AddSsoAccount.cshtml" />
		<None Remove="Views\GroupRoleMappings.cshtml" />
		<None Remove="Views\CreateOrUpdateGroupRoleMapping.cshtml" />
		<None Remove="Views\MockSso\Login.cshtml" />
	</ItemGroup>

