<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Copyright>Copyright © Cityweb</Copyright>
		<Company>CW Cityweb</Company>
		<Authors>CW Cityweb</Authors>
		<RepositoryType>Git</RepositoryType>
		<OutputPath>$(SolutionDir)\Presentation\Nop.Web\Plugins\ExternalAuth.SSO</OutputPath>
		<OutDir>$(OutputPath)</OutDir>
		<!--Set this parameter to true to get the dlls copied from the NuGet cache to the output of your project.
    You need to set this parameter to true if your plugin has a nuget package
    to ensure that the dlls copied from the NuGet cache to the output of your project-->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<!-- Unit tests of internal helpers (token match, email-domain allowlist, role changes) — Tests/CW.Tests. -->
