@{
    Layout = "";
}

@*
    "Sign in with Microsoft" button. Style follows Microsoft's branding guidelines for
    "Sign in with Microsoft" buttons — white background, Microsoft logo on the left,
    Segoe UI label on the right. Minimal CSS inlined so the plugin doesn't depend on
    shipping a separate stylesheet.
*@
<div class="microsoft-login-block" style="margin: 8px 0;">
    <a asp-controller="ExternalAuthentication"
       asp-action="Login"
       asp-route-returnurl="@Context.Request.Query["ReturnUrl"]"
       style="display: inline-flex; align-items: center; gap: 12px;
              background: #fff; color: #5e5e5e;
              border: 1px solid #8c8c8c; border-radius: 2px;
              padding: 10px 12px; min-width: 215px;
              font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; font-size: 15px; font-weight: 600;
              text-decoration: none; cursor: pointer;">
        @* Microsoft "four squares" logo — inline SVG to avoid a content file *@
        <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 21 21" aria-hidden="true">
            <rect x="1"  y="1"  width="9" height="9" fill="#f25022" />
            <rect x="11" y="1"  width="9" height="9" fill="#7fba00" />
            <rect x="1"  y="11" width="9" height="9" fill="#00a4ef" />
            <rect x="11" y="11" width="9" height="9" fill="#ffb900" />
        </svg>
        @{
            var idpName = ViewData["IdpDisplayName"] as string ?? "Microsoft";
            var template = T("Plugins.ExternalAuth.SSO.Button.SignInWith").Text;
        }
        <span>@(string.Format(template, idpName))</span>
    </a>
</div>
