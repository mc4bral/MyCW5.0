@model Nop.Plugin.ExternalAuth.SSO.Models.ConfigurationModel
@* Configure page, card "microsoft-general" — the <nop-card> wrapper is in Views/Configure.cshtml. *@

<div class="card-body">
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="Protocol" />
        </div>
        <div class="col-md-9">
            <nop-select asp-for="Protocol" asp-items="Html.GetEnumSelectList<SsoProtocol>()" />
            <span asp-validation-for="Protocol"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="IsEnabled" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="IsEnabled" />
            <span asp-validation-for="IsEnabled"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="IdpDisplayName" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="IdpDisplayName" />
            <span asp-validation-for="IdpDisplayName"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="BaseUrl" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="BaseUrl" asp-required="true" />
            <span asp-validation-for="BaseUrl"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="DisplayOrder" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="DisplayOrder" />
            <span asp-validation-for="DisplayOrder"></span>
        </div>
    </div>
</div>
