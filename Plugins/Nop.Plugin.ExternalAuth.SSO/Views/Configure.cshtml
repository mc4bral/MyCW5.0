@*
    Inline scripts — kept here so the page is self-contained.
    1. IdP metadata import (M7) — POST to ImportIdpMetadata, prefill IdP fields.
    2. Onboarding report — fetch + render + copy/refresh (M9 + M13).
    3. Test SSO Connection — call M12 TestConnection for current scope.
*@
<script>
    (function () {
        function escapeHtml(s) { var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

        function antiforgeryFormData() {
            var fd = new FormData();
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) fd.append('__RequestVerificationToken', token.value);
            return fd;
        }

        // --- IdP metadata import (M7) ----------------------------------------
        var importBtn = document.getElementById('btnImportIdpMetadata');
        if (importBtn) {
            importBtn.addEventListener('click', function () {
                var urlInput = document.getElementById('IdpMetadataUrlImport');
                var fileInput = document.getElementById('IdpMetadataFileImport');
                var status = document.getElementById('IdpMetadataImportStatus');
                var fd = antiforgeryFormData();
                if (fileInput.files && fileInput.files.length > 0) fd.append('file', fileInput.files[0]);
                else if (urlInput.value && urlInput.value.trim() !== '') fd.append('url', urlInput.value.trim());
                else { status.innerHTML = '<span class="text-danger">@T("Plugins.ExternalAuth.SSO.IdpMetadata.Error.NoInput")</span>'; return; }

                status.innerHTML = '<i class="fas fa-spinner fa-spin"></i> @T("Plugins.ExternalAuth.SSO.IdpMetadata.Importing")';
                importBtn.disabled = true;
                fetch('@Url.Action("ImportIdpMetadata", "ExternalAuthSSO")', { method: 'POST', body: fd, credentials: 'same-origin' })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        importBtn.disabled = false;
                        if (!data || !data.success) {
                            status.innerHTML = '<span class="text-danger">' + escapeHtml((data && data.error) || '@T("Plugins.ExternalAuth.SSO.IdpMetadata.Error.Generic")') + '</span>';
                            return;
                        }
                        var r = data.result;
                        if (r.idpEntityId) document.getElementById('IdpEntityId').value = r.idpEntityId;
                        if (r.idpSsoUrl) document.getElementById('IdpSsoUrl').value = r.idpSsoUrl;
                        if (r.idpSloUrl) document.getElementById('IdpSloUrl').value = r.idpSloUrl;
                        if (r.idpCertificateBase64) { var c = document.getElementById('IdpCertificateBase64'); if (c) c.value = r.idpCertificateBase64; }
                        status.innerHTML = '<span class="text-success"><i class="fas fa-check"></i> @T("Plugins.ExternalAuth.SSO.IdpMetadata.Imported")</span>';
                    })
                    .catch(function (err) {
                        importBtn.disabled = false;
                        status.innerHTML = '<span class="text-danger">' + escapeHtml(err.message || '@T("Plugins.ExternalAuth.SSO.IdpMetadata.Error.Generic")') + '</span>';
                    });
            });
        }

        // --- Onboarding report (M9 + M13) ------------------------------------
        var refreshBtn = document.getElementById('btnRefreshOnboardingReport');
        var copyBtn = document.getElementById('btnCopyOnboardingReport');
        var textArea = document.getElementById('OnboardingReportText');

        function loadOnboardingReport() {
            if (!textArea) return;
            textArea.value = '@T("Plugins.ExternalAuth.SSO.OnboardingReport.Loading")';
            fetch('@Url.Action("OnboardingReport", "ExternalAuthSSO")', { credentials: 'same-origin' })
                .then(function (r) { return r.text(); })
                .then(function (txt) { textArea.value = txt; })
                .catch(function (err) { textArea.value = err.message || '@T("Plugins.ExternalAuth.SSO.OnboardingReport.Error")'; });
        }

        if (refreshBtn) refreshBtn.addEventListener('click', loadOnboardingReport);
        if (textArea) loadOnboardingReport();

        if (copyBtn && textArea) {
            copyBtn.addEventListener('click', function () {
                textArea.select();
                document.execCommand('copy');
            });
        }

        // --- Protocol-aware card visibility ---------------------------------
        // When OpenID Connect is selected, hide the SAML-only cards (Identity
        // Provider, Send to IdP team, Service Provider) and the SAML-only
        // binding rows inside the mixed "Bindings & Redirects" card. When
        // SAML 2.0 is selected, hide the OpenID Connect card. When Off,
        // show everything so the admin can pre-fill before flipping protocol on.
        // Enum values mirror Nop.Plugin.ExternalAuth.SSO.Settings.SsoProtocol:
        // Off = 0, OpenIdConnect = 1, Saml2 = 2.
        var protocolSelect = document.getElementById('Protocol');
        if (protocolSelect) {
            // Whole cards hidden by protocol. microsoft-sendtoIdp stays visible for both
            // OIDC and SAML now that it carries protocol-aware inner sections — the
            // inner-container lists below toggle which one shows.
            var samlCardIds = ['microsoft-idp', 'microsoft-sp'];
            var oidcCardIds = ['microsoft-oidc'];

            // Arbitrary container divs hidden by protocol (used for inner sections that
            // live inside a card kept visible for both protocols, e.g. Send-to-IdP team).
            var samlOnlyContainerIds = ['sendToIdp-saml-section'];
            var oidcOnlyContainerIds = ['sendToIdp-oidc-section'];

            // Individual form-group rows hidden by protocol — resolved by walking up from
            // the input id to its enclosing .form-group.
            var samlOnlyFieldIds = ['LoginBinding', 'LogoutBinding'];

            function setVisible(el, visible) {
                if (el) el.style.display = visible ? '' : 'none';
            }

            function rowFor(fieldId) {
                var input = document.getElementById(fieldId);
                return input ? input.closest('.form-group') : null;
            }

            function applyProtocolVisibility() {
                var p = parseInt(protocolSelect.value, 10);
                var showOidc = p !== 2; // hide OIDC content when SAML selected
                var showSaml = p !== 1; // hide SAML content when OIDC selected
                oidcCardIds.forEach(function (id) { setVisible(document.getElementById(id), showOidc); });
                samlCardIds.forEach(function (id) { setVisible(document.getElementById(id), showSaml); });
                oidcOnlyContainerIds.forEach(function (id) { setVisible(document.getElementById(id), showOidc); });
                samlOnlyContainerIds.forEach(function (id) { setVisible(document.getElementById(id), showSaml); });
                samlOnlyFieldIds.forEach(function (id) { setVisible(rowFor(id), showSaml); });
            }

            applyProtocolVisibility();
            protocolSelect.addEventListener('change', applyProtocolVisibility);
        }

        // --- Test SSO Connection (M12 + M14 handshake) -----------------------
        // Renders the existing legacy-style banner + a per-check handshake panel
        // (EntityID / SSO URL / SLO URL / Certificate) when the handshake actually ran.
        // SkippedReason → muted "handshake not attempted" notice so the admin knows the
        // basic checks ran but the cryptographic match did not.
        var testBtn = document.getElementById('btnTestSsoConnection');
        if (testBtn) {
            testBtn.addEventListener('click', function () {
                var result = document.getElementById('TestSsoConnectionResult');
                var storeId = @Model.ActiveStoreScopeConfiguration;
                result.style.display = 'block';
                result.className = 'alert alert-info mt-3';
                result.innerHTML = '<i class="fas fa-spinner fa-spin"></i> @T("Plugins.ExternalAuth.SSO.Cards.TestConnection.Running")';
                var fd = antiforgeryFormData();
                fd.append('storeId', storeId);
                fetch('@Url.Action("TestConnection", "ExternalAuthSSO")', { method: 'POST', body: fd, credentials: 'same-origin' })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        result.className = 'alert mt-3 ' + (data.success ? 'alert-success' : 'alert-danger');
                        result.innerHTML = renderTestResult(data);
                    })
                    .catch(function (err) {
                        result.className = 'alert mt-3 alert-danger';
                        result.textContent = err.message || 'Test connection request failed.';
                    });
            });
        }

        function renderTestResult(data) {
            var html = '<strong>' + (data.success ? '✓' : '✗') + '</strong> ' + escapeHtml(data.message || '');
            if (data.details) html += '<pre class="mt-2 mb-2" style="white-space:pre-wrap;">' + escapeHtml(data.details) + '</pre>';

            var h = data.handshake;
            if (!h) return html;

            if (h.skippedReason) {
                html += '<div class="mt-2"><em class="text-muted">'
                     + '@T("Plugins.ExternalAuth.SSO.Cards.TestConnection.HandshakeSkipped"): '
                     + escapeHtml(h.skippedReason) + '</em></div>';
                return html;
            }

            html += '<div class="mt-3"><strong>@T("Plugins.ExternalAuth.SSO.Cards.TestConnection.HandshakeTitle"):</strong>';
            html += '<ul class="list-unstyled mb-0 mt-1">';
            html += handshakeCheckRow(h.entityIdMatches, '@T("Plugins.ExternalAuth.SSO.Cards.TestConnection.Check.EntityId")');
            html += handshakeCheckRow(h.ssoUrlMatches, '@T("Plugins.ExternalAuth.SSO.Cards.TestConnection.Check.SsoUrl")');
            html += handshakeCheckRow(h.sloUrlMatches, '@T("Plugins.ExternalAuth.SSO.Cards.TestConnection.Check.SloUrl")');
            html += handshakeCheckRow(h.certificateMatches, '@T("Plugins.ExternalAuth.SSO.Cards.TestConnection.Check.Certificate")');
            html += '</ul></div>';

            if (h.signingKeyThumbprints && h.signingKeyThumbprints.length > 0) {
                html += '<div class="mt-3"><strong>@T("Plugins.ExternalAuth.SSO.Cards.TestConnection.MetadataThumbprints"):</strong>';
                html += '<ul class="small mb-0 mt-1" style="font-family: monospace;">';
                h.signingKeyThumbprints.forEach(function (t) {
                    html += '<li>' + escapeHtml(t) + '</li>';
                });
                html += '</ul></div>';
            }
            return html;
        }

        function handshakeCheckRow(passed, label) {
            var icon = passed
                ? '<i class="fas fa-check-circle text-success"></i>'
                : '<i class="fas fa-times-circle text-danger"></i>';
            return '<li>' + icon + ' ' + label + '</li>';
        }
    })();

    // Generic "Copy" helper for the readonly URL fields in the Send-to-IdP card
    // (SAML SP metadata URL, OIDC Redirect URI, OIDC Post-logout Redirect URI).
    // Called inline from onclick="copyReadonlyField('FieldId')".
    function copyReadonlyField(fieldId) {
        var field = document.getElementById(fieldId);
        if (!field) return;
        field.select();
        document.execCommand('copy');
    }

</script>
